{
  "name": "paperly-ai",
  "type": "module",
  "version": "0.9.37",
  "description": "Paperly AI: an AI panel beside the reader, a reading status you can tick from the item list, and a starred collection. A plugin for Paperly.",
  "author": "quynhtl",
  "homepage": "https://github.com/quynhtl/Paperly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quynhtl/Paperly.git"
  },
  "config": {
    "addonName": "Paperly AI",
    "addonID": "paperly-ai@paperly.org",
    "addonRef": "zotero-webai",
    "addonInstance": "ZoteroWebAI",
    "prefsPrefix": "extensions.zotero.zotero-webai"
  },
  "scripts": {
    "build": "node scripts/scaffold-build.mjs && tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.7.2",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "bugs": {
    "url": "https://github.com/quynhtl/Paperly/issues"
  }
}
